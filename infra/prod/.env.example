# Zero-memory production environment. Copy to infra/prod/.env and fill in.
# NOTE: docker compose does NOT treat backslashes as escapes — put literal
# values here (e.g. a password containing `$` must be written as `$$`).

# ── Supabase ────────────────────────────────────────────────────────────────
# The database lives outside this compose project: the app reaches it over the
# network and does not care where it runs. Supabase API gateway (Kong) as seen
# FROM INSIDE the containers:
#   hosted Supabase project:  https://<project-ref>.supabase.co
#   stack published on this host (e.g. Supabase CLI): http://host.docker.internal:55321
#   stack in Docker here, addressed by service name:  http://supabase-kong:8000
#     ^ that last one requires the attach overlay, docker-compose.supabase-network.yml
SUPABASE_URL=https://your-project.supabase.co

# ONLY used with docker-compose.supabase-network.yml — the existing Docker
# network of a Supabase stack running on this host. Ignored otherwise.
# Self-hosted supabase docker compose (project `supabase`): supabase_default
# Supabase CLI stack: supabase_network_<project>
#SUPABASE_DOCKER_NETWORK=supabase_default

# Keys from the Supabase stack (`.env` of the self-hosted stack, or
# `supabase status` for the CLI stack).
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# ── MCP server ──────────────────────────────────────────────────────────────
# Backend host ports bind to loopback by default. Keep this value for Caddy
# and host-nginx deployments; only change it for an intentional direct expose.
ZM_BIND_HOST=127.0.0.1

# Host port the MCP server is published on.
ZM_SERVER_PORT=8787

# EXTERNAL base URL of the MCP server = OAuth issuer. Must match exactly what
# MCP clients connect to (scheme, host, port). With TLS at a reverse proxy this
# is the https:// URL of that proxy. A bare origin: no path, query or fragment.
# With ZM_TRUST_PROXY=true (below) the server REFUSES TO START if this is
# missing or not https on a public host — a wrong issuer breaks every client at
# once and does it silently, so it fails loudly at boot instead.
ZM_PUBLIC_URL=https://zm.example.com

# Service account the server and hooks sign in with.
ZM_EMAIL=admin@example.com
ZM_PASSWORD=replace-with-password

# LLM extractor for ingest_conversation.
ANTHROPIC_API_KEY=replace-with-api-key

# Ollama's base_url is the one LLM endpoint a user chooses rather than a
# fixed vendor host, which the server then fetches from. On a single-operator
# instance that is not a risk — leave unset (the default). Set true only when
# this instance's database is shared by users who should not be able to make
# the server reach into each other's network (e.g. 169.254.169.254 or
# another user's localhost service) via that endpoint.
#ZM_POLICY_DENY_PRIVATE_ENDPOINTS=true

# ── Web dashboard ───────────────────────────────────────────────────────────
# Host port the dashboard is published on.
ZM_WEB_PORT=3100

# Supabase URL/key as seen FROM THE BROWSER. Read at RUNTIME and handed to the
# browser in the document, so changing them needs a restart, not a rebuild.
# Must be reachable from users' machines (typically the public URL of your
# Supabase project or reverse proxy).
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# ── Documentation site ──────────────────────────────────────────────────────
# Host port the documentation is published on.
ZM_DOCS_PORT=3200

# Page uploads write into the content tree inside the container, which the next
# deploy replaces. Unset (the default) every request is refused — the form and
# its action still exist, they simply never accept anything.
#ZM_DOCS_UPLOAD_TOKEN=

# Addresses the documentation STATES. Unlike everything else here, these are
# read when the image is BUILT, so they only apply to a local
# `up --build`; a published image carries the values its release job passed.
# An unset bundle URL is not an error — the install page then renders a
# build-from-source note instead of a dead download button.
#ZM_CLIENT_BUNDLE_URL=/files/zm-bundle-0.0.0-linux-x86_64.zip
#ZM_CLIENT_BUNDLE_VERSION=0.0.0
#ZM_HOSTED_MCP_URL=https://zm.example.com/mcp
#ZM_HOSTED_WEB_URL=https://memory.example.com

# ── Images ──────────────────────────────────────────────────────────────────
# Empty prefix builds locally from this checkout. To deploy published images
# instead, point at the registry (KEEP the trailing slash) and pin a version:
#   ZM_IMAGE_PREFIX=ghcr.io/<owner>/
#   ZM_IMAGE_TAG=1.4.0
# then `docker compose pull && docker compose up -d --no-build`.
ZM_IMAGE_PREFIX=
ZM_IMAGE_TAG=latest

# ── Edge (Caddy overlay, docker-compose.caddy.yml) ──────────────────────────
# Caddy config mounted by the overlay. Keep the production ACME template.
# The local rehearsal command overrides this with Caddyfile.rehearsal.
CADDYFILE_PATH=./caddy/Caddyfile.template

# Hostname the MCP server is served on. The resulting https URL MUST equal
# ZM_PUBLIC_URL exactly (scheme, host, port) — it is the OAuth issuer.
ZM_SERVER_HOST=zm.example.com

# Hostname the web dashboard is served on.
ZM_WEB_HOST=memory.example.com

# Hostname the documentation site is served on.
ZM_DOCS_HOST=docs.example.com

# Legal texts this instance publishes, and the consent they gate. Leave BOTH
# empty on a personal install: the sign-up form then shows no checkbox and no
# links, which is the honest state for an instance whose operator publishes no
# documents. Set either and creating an account requires ticking an explicit
# acceptance first. Each value is an https URL or a site-root path served by
# the edge from ZM_LEGAL_DIR (a file terms.html there answers at /terms).
ZM_TERMS_URL=
ZM_PRIVACY_URL=

# Optional label stored with each acceptance, so a later question about WHICH
# text somebody agreed to has an answer. A date is enough.
ZM_TERMS_VERSION=

# Directory the edge serves those texts from, read-only. Defaults to an empty
# ./legal next to this file; point it at wherever the documents are kept.
#ZM_LEGAL_DIR=./legal

# Optional: hostname to expose the Supabase API gateway (Kong) on — the
# browser needs it for the dashboard. Requires uncommenting the matching
# site block in caddy/Caddyfile.template. The resulting https URL is what
# NEXT_PUBLIC_SUPABASE_URL must be set to. A hosted Supabase project already
# has its own domain and needs none of this.
#SUPABASE_HOST=supabase.example.com

# Upstream that optional site proxies to. The default resolves only with the
# attach overlay; for a stack published on this host use
# host.docker.internal:<port>.
#SUPABASE_UPSTREAM=supabase-kong:8000

# Host ports the proxy is published on. Leave at the defaults for real
# deployments (ACME needs :80/:443); override only for local testing on
# alternative ports.
CADDY_BIND_HOST=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Trust X-Forwarded-For for rate-limit keying. MUST be true only when zm-server
# is reachable exclusively through the edge proxy (caddy/nginx overlays set the
# header). Leave false for a direct-exposed server — trusting client-supplied
# XFF would let an attacker mint a fresh rate-limit bucket per request.
ZM_TRUST_PROXY=true
