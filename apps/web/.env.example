# Supabase Data API — local stack values come from `bunx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key>"

# Server-only. Used exclusively by the add-member email lookup on /scopes;
# never referenced from client components (NEXT_PUBLIC_* only goes to the
# browser). Optional: without it, member emails degrade to raw user ids.
SUPABASE_SERVICE_ROLE_KEY="<service role key>"

# Legal texts this deployment publishes. Unset (the default) means the sign-up
# form asks for no consent and shows no links — the product ships the
# mechanism, never the terms. An https URL, or a site-root path when the edge
# serves the documents next to the dashboard.
ZM_TERMS_URL=
ZM_PRIVACY_URL=
# Optional label recorded with each acceptance, e.g. the document's date.
ZM_TERMS_VERSION=
