# All variables fall back to the repo root .env (seeded by `bun scripts/seed-env.ts`),
# so a dedicated tests/e2e/.env is only needed to override the defaults.

# Target stack. Defaults: local dev (`bun dev`).
# E2E_SERVER_URL=http://localhost:8787
# E2E_WEB_URL=http://localhost:3100

# Supabase (defaults come from the root .env).
# SUPABASE_URL=http://127.0.0.1:55321
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Dedicated e2e accounts (provisioned idempotently by global setup; never the
# dev/admin account). Override only if the defaults collide with real users.
# E2E_USER_A_EMAIL=e2e-a@zm.e2e
# E2E_USER_B_EMAIL=e2e-b@zm.e2e
# E2E_PASSWORD=e2e-zero-memory

# OAuth rate-limit expectations (must match the server's ZM_RATELIMIT_* env).
# E2E_RATELIMIT_MAX=30
