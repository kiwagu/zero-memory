# Local-only workspace
refs/

# Cluster snapshots (default ZM_SNAPSHOT_DIR)
.snapshots/

# Claude Code runtime artifacts
.claude/*.lock
.claude/settings.local.json

# Dependencies
node_modules/
.bun/

# Build outputs
.next/
# Dist dir of a second local dev server on the same working tree (NEXT_DIST_DIR)
.next-review/
out/
dist/
build/
.turbo/

# Env & secrets
.env
.env.*
!.env.example

# Supabase local dev
supabase/.temp/
supabase/.branches/

# Logs & misc
*.log
.DS_Store
coverage/

# Assistant agents stay untracked
.claude/agents/

# Next.js generated type reference (regenerated per build/dev)
next-env.d.ts

# machine-local symlink created by scripts/plugin-bundle/deploy-zm-claude.sh at install time
plugins/zero-memory-claude/bin/

# Generated by fumadocs-mdx from the docs/ content tree.
apps/docs/.source/

# Python bytecode caches. The Hermes plugin (plugins/zero-memory-hermes/) is the
# repository's only Python source, and its caches appear the moment a Hermes
# profile imports it from a working copy — per-interpreter build artifacts that
# must never be committed or shipped in a client bundle.
__pycache__/
*.py[cod]

# Per-machine TLS pair for the dev API gateway — generated by
# infra/dev/gateway-tls.sh on first start. A committed private key is public
# the moment the repository is, and one shared key makes the gateway's TLS
# decorative for everyone who checks the project out.
infra/dev/supabase/volumes/api/server.crt
infra/dev/supabase/volumes/api/server.key
