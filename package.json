{
  "name": "zero-memory",
  "version": "0.18.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun run env:seed && turbo dev",
    "start": "bun run env:seed && turbo start",
    "env:seed": "bun scripts/seed-env.ts",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:strict": "turbo lint:strict",
    "typecheck": "turbo typecheck && bun run typecheck:scripts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "format": "turbo format",
    "format:check": "prettier --check .",
    "db:migrate:e2e": "bunx supabase migration up --workdir tests/e2e",
    "db:sync": "bun run db:migrate:e2e && bun run db:types",
    "db:types": "bun run --cwd packages/db gen-types",
    "test": "CI=1 turbo run test:vitest",
    "test:integration": "CI=1 turbo run test:integration",
    "test:e2e": "CI=1 turbo run test:e2e",
    "test:e2e:smoke": "CI=1 turbo run test:e2e:smoke",
    "test:e2e:full": "CI=1 turbo run test:e2e:full",
    "test:all": "bun run test && bun run test:e2e:smoke",
    "test:all:full": "bun run test && bun run test:e2e:full",
    "prod:rehearse": "bun scripts/rehearse-production.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun scripts/check-env-templates.ts",
    "prepare": "husky && sh scripts/setup-git-merge-policy.sh",
    "postinstall": "husky && sh scripts/setup-git-merge-policy.sh"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@workspace/client-core": "workspace:*",
    "@workspace/client-runtime": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/mcp-oauth-client": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "prettier": "^3.9.1",
    "turbo": "^2.10.0",
    "@types/node": "catalog:",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.3.11"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tests/*"
    ],
    "catalog": {
      "@ai-sdk/anthropic": "^4.0.16",
      "@ai-sdk/deepseek": "^3.0.12",
      "@ai-sdk/openai": "^4.0.16",
      "@ai-sdk/openai-compatible": "^3.0.12",
      "@ai-sdk/xai": "^4.0.16",
      "@huggingface/transformers": "^4.2.0",
      "@modelcontextprotocol/sdk": "^1.29.0",
      "@react-email/components": "^1.0.12",
      "@react-email/render": "^2.1.0",
      "@supabase/ssr": "^0.12.0",
      "@supabase/supabase-js": "^2.108.2",
      "@tailwindcss/postcss": "^4.3.1",
      "@types/node": "^25.9.3",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "ai": "^7.0.31",
      "dequal": "^2.0.3",
      "elysia": "^1.4.29",
      "entity-id": "^1.0.0",
      "eslint": "^10.6.0",
      "lucide-react": "^1.22.0",
      "nanoid": "^5.1.16",
      "next": "16.2.9",
      "next-themes": "^0.4.6",
      "oxide.ts": "^1.1.0",
      "prettier": "^3.9.1",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "reflect-metadata": "^0.2.2",
      "resend": "^6.18.0",
      "shadcn": "^4.12.0",
      "tailwindcss": "^4.3.1",
      "tsyringe": "^4.10.0",
      "tw-animate-css": "^1.4.0",
      "typescript": "^6.0.3",
      "ulid": "^3.0.0",
      "vitest": "^4.1.9",
      "zod": "^4.5.4"
    }
  }
}
