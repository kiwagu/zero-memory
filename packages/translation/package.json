{
  "name": "@workspace/translation",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "sideEffects": false,
  "scripts": {
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "bunx prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:vitest": "vitest run"
  },
  "dependencies": {
    "@workspace/di": "workspace:*",
    "@workspace/embedding": "workspace:*",
    "@workspace/llm": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/memory": "workspace:*",
    "@workspace/persistence": "workspace:*",
    "@workspace/usage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:^",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  }
}
