{
  "name": "@workspace/i18n-catalogs",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "sideEffects": false,
  "scripts": {
    "lint": "eslint . && bun src/validate.ts",
    "lint:strict": "eslint . --max-warnings 0 && bun src/validate.ts",
    "format": "bunx prettier --write .",
    "typecheck": "tsc --noEmit",
    "validate": "bun src/validate.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:^",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./manifest": {
      "types": "./src/manifest.ts",
      "import": "./src/manifest.ts",
      "default": "./src/manifest.ts"
    },
    "./web": {
      "types": "./src/web/index.ts",
      "import": "./src/web/index.ts",
      "default": "./src/web/index.ts"
    },
    "./mail": {
      "types": "./src/mail/index.ts",
      "import": "./src/mail/index.ts",
      "default": "./src/mail/index.ts"
    }
  }
}
