{
  "name": "@workspace/email",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "lint": "eslint . && bun src/mail.export.ts --check",
    "lint:strict": "eslint . --max-warnings 0 && bun src/mail.export.ts --check",
    "format": "bunx prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:vitest": "vitest run",
    "mail:export": "bun src/mail.export.ts",
    "mail:check": "bun src/mail.export.ts --check"
  },
  "dependencies": {
    "@react-email/components": "catalog:",
    "@react-email/render": "catalog:",
    "@workspace/i18n-catalogs": "workspace:*",
    "@workspace/logger": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "resend": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:^",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
